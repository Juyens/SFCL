# Normalize line endings to LF in the repository
* text=auto

# Source
*.cpp text
*.hpp text
*.h   text
*.txt text
*.md  text
*.cmake text

# Windows scripts need CRLF
*.bat eol=crlf
*.cmd eol=crlf
*.ps1 eol=crlf

# Binary
*.png binary
*.jpg binary
*.ico binary
*.exe binary
*.dll binary
*.lib binary
